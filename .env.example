# Copia este fichero a .env en el checkout principal y rellena los valores.
# Nunca commitees .env. Los worktrees leen este .env desde el checkout principal:
# no copies el fichero a cada worktree.
# Token de Kan.bn: Settings -> API -> Create new key.
kan_API_KEY=kan_...
# Email del miembro activo que usan las escrituras y comentarios del agente en Kan.
# Obligatorio: el agente lo lee con `kan-sync whoami` y firma cada comentario con él.
kan_CURRENT_USER=tu@email.com

# Nube opcional (Supabase). Estos valores van en apps/web/.env.local, no en .env:
# Next.js solo expone al navegador las variables con prefijo NEXT_PUBLIC_.
# Usa siempre la anon public key; nunca la service_role key.
# NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-public-key>
